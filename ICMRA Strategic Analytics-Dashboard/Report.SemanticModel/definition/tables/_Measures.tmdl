	measure 'Selected Measure Value' =
			SWITCH(
			    SELECTEDVALUE('Select Measure'[Select Measure]),
			    "Total Paid",    [Total Paid],
			    "Total Pledged", [Total Pledged],
			    "Paid Pledges",  [Paid Pledges],
			    [Total Paid]
			)
		formatString: #,##0
		displayFolder: What-If
