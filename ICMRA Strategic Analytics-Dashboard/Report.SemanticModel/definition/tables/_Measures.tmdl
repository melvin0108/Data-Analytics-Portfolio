	measure 'Avg Pledge Size' = DIVIDE([Total Paid], [Paid Pledges])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Performance Metrics
		lineageTag: c468f286-eabb-4a7d-aa82-de5dd8ab633a

	measure 'Pledge Conversion %' = ```
			
			  VAR AllPledges = CALCULATE(
			      DISTINCTCOUNT('Medical Research Grant Appeal'[Pledge ID]),
			      USERELATIONSHIP('Medical Research Grant Appeal'[Appeal Close Date], Dim_Date[Date])
			  )
			  VAR PaidPledges = CALCULATE(
			      DISTINCTCOUNT('Medical Research Grant Appeal'[Pledge ID]),
			      'Medical Research Grant Appeal'[Payment Status] = "Paid",
			      USERELATIONSHIP('Medical Research Grant Appeal'[Appeal Close Date], Dim_Date[Date])
			  )
			  RETURN DIVIDE(PaidPledges, AllPledges)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Performance Metrics
		lineageTag: 3d0c16cc-e76d-4331-a35a-e61b67aa5703

	measure 'Avg Days to Pay' =
			AVERAGEX(
			    FILTER('Medical Research Grant Appeal', NOT ISBLANK('Medical Research Grant Appeal'[Days to Pay])),
			    'Medical Research Grant Appeal'[Days to Pay]
			)
		formatString: 0.0
		displayFolder: Performance Metrics
		lineageTag: 93ba48dd-7e43-4d32-b87d-7a4573a164c0

	measure 'Total Campaign Budget' = ```
			
			  VAR SelYear = SELECTEDVALUE(Dim_Date[Year])
			  RETURN
			  IF(ISBLANK(SelYear),
			      SUM('MRA Campaign'[Campaign Budget]),
			      SUMX(
			          'MRA Campaign',
			          VAR CampStart = 'MRA Campaign'[Campaign Start Date]
			          VAR CampEnd   = 'MRA Campaign'[Campaign End Date]
			          VAR YearStart = DATE(SelYear, 1, 1)
			          VAR YearEnd   = DATE(SelYear, 12, 31)
			          VAR OverStart = MAX(CampStart, YearStart)
			          VAR OverEnd   = MIN(CampEnd, YearEnd)
			          VAR OverDays  = IF(OverStart <= OverEnd, OverEnd - OverStart + 1, 0)
			          VAR TotalDays = CampEnd - CampStart + 1
			          RETURN 'MRA Campaign'[Campaign Budget] * DIVIDE(OverDays, TotalDays)
			      )
			  )
			
			```
		formatString: 0.00
		displayFolder: Performance Metrics
		lineageTag: 1812650b-a5da-4ada-a1ac-a478c7e1ed85

	measure 'Total Target' = ```
			
			  VAR SelYear = SELECTEDVALUE(Dim_Date[Year])                                                                                                                     
			  RETURN
			  IF(ISBLANK(SelYear),
			      SUM('MRA Campaign'[Target Amount]),
			      SUMX(
			          'MRA Campaign',
			          VAR CampStart = 'MRA Campaign'[Campaign Start Date]
			          VAR CampEnd   = 'MRA Campaign'[Campaign End Date]
			          VAR YearStart = DATE(SelYear, 1, 1)
			          VAR YearEnd   = DATE(SelYear, 12, 31)
			          VAR OverStart = MAX(CampStart, YearStart)
			          VAR OverEnd   = MIN(CampEnd, YearEnd)
			          VAR OverDays  = IF(OverStart <= OverEnd, OverEnd - OverStart + 1, 0)
			          VAR TotalDays = CampEnd - CampStart + 1
			          RETURN 'MRA Campaign'[Target Amount] * DIVIDE(OverDays, TotalDays)
			      )
			  )
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Performance Metrics
		lineageTag: f6ad9d58-d3fc-4b7e-923e-1bb6df457cc3

