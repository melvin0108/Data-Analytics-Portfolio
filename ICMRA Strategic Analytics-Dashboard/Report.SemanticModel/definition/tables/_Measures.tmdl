	measure 'Pair Support' =
			VAR PairCount = DISTINCTCOUNT(BasketPairs[AccountID])
			VAR N = CALCULATE(DISTINCTCOUNT(BasketPairs[AccountID]), ALL(BasketPairs))
			RETURN DIVIDE(PairCount, N)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Market Basket
		lineageTag: 1a82766c-559b-4e94-b7bd-5d4f1a102119

	measure 'Pair Confidence' =
			VAR PairCount = DISTINCTCOUNT(BasketPairs[AccountID])
			VAR AntCount =
			    CALCULATE(
			        DISTINCTCOUNT(BasketPairs[AccountID]),
			        ALL(BasketPairs[Consequent]),
			        ALL(BasketPairs[Pair Label])
			    )
			RETURN DIVIDE(PairCount, AntCount)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Market Basket
		lineageTag: 28736ca8-4b32-48c0-beaf-1fc4191a1a5e

	measure 'Pair Lift' =
			VAR PairCount = DISTINCTCOUNT(BasketPairs[AccountID])
			VAR N = CALCULATE(DISTINCTCOUNT(BasketPairs[AccountID]), ALL(BasketPairs))
			VAR AntCount =
			    CALCULATE(
			        DISTINCTCOUNT(BasketPairs[AccountID]),
			        ALL(BasketPairs[Consequent]),
			        ALL(BasketPairs[Pair Label])
			    )
			VAR ConCount =
			    CALCULATE(
			        DISTINCTCOUNT(BasketPairs[AccountID]),
			        ALL(BasketPairs[Antecedent]),
			        ALL(BasketPairs[Pair Label])
			    )
			RETURN DIVIDE(PairCount * N, AntCount * ConCount)
		formatString: 0.00
		displayFolder: Market Basket
		lineageTag: d51a2cde-9fb4-40c2-a433-cc0da5a6f5b3

