	measure 'Total Paid Growth KPI' =
			
			VAR _Growth = [Total Paid YoY Growth %]
			VAR _CurrentYear = SELECTEDVALUE(Dim_Date[Year])
			VAR _PrevousYear = IF(HASONEVALUE(Dim_Date[Year]), _CurrentYear - 1, "PY")
			RETURN
			IF(
			    ISBLANK(_Growth),
			    BLANK(),
			    FORMAT(_Growth, "0.00%") & IF(_Growth > 0, " ▲", " ▼") & " vs " &
			    _PrevousYear
			)
		displayFolder: Time Intelligence\Paid
		lineageTag: f3b699d7-f202-4824-a785-c75073985cbe

	measure 'Total Paid Trend Color' = IF([Total Paid YoY Growth %] >= 0, "#38b64b", "#ee1c25")
