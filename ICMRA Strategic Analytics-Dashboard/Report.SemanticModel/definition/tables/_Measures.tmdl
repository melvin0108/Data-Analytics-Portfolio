	measure 'Line Bar Color' =
			VAR MaxVal = MAXX(ALLSELECTED(Dim_Date[Year Month]), [Total Paid])
			VAR MinVal = MINX(ALLSELECTED(Dim_Date[Year Month]), [Total Paid])
			RETURN
			IF([Total Paid] = MaxVal, "#38b64b",
			   IF([Total Paid] = MinVal, "#ee1c25", "#2E86DE"))
		displayFolder: Charts\Line
		lineageTag: b20f7659-52c4-479f-9889-f12ef5c05db9

	measure 'Sparkline Marker Color' =
			VAR MaxVal = MAXX(ALLSELECTED(Dim_Date[Year Month]), [Total Paid])
			VAR MinVal = MINX(ALLSELECTED(Dim_Date[Year Month]), [Total Paid])
			RETURN SWITCH(TRUE(),
