	measure 'Donor Category' =
			
			VAR AvgDays = [Avg Days to Pay]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(AvgDays), BLANK(),
			        AvgDays < 0, "Proactive Donors",
			        AvgDays = 0, "On Time Donors",
			        AvgDays > 0, "Slow Payers"
			    )
		lineageTag: 903604f6-d47f-426b-8738-3129c6800614

