	measure 'Total Paid' =
			CALCULATE(
			    SUM('Medical Research Grant Appeal'[Pledge-Pay Amount]),
			    'Medical Research Grant Appeal'[Payment Status] = "Paid"
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Performance Metrics
		lineageTag: d116b8cb-41f2-4008-ad10-6906bb2488ec

	measure 'Paid Pledges' =
			CALCULATE(
