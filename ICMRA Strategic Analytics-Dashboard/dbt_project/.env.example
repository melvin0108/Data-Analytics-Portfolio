# ═══════════════════════════════════════════════════════════════════
# Environment Variables — Copy to .env and fill in your credentials
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════════════

# Snowflake Account (find in Snowflake UI: Admin → Accounts)
SNOWFLAKE_ACCOUNT=your_org-your_account

# Snowflake Credentials (for dev target — use key-pair auth for prod)
SNOWFLAKE_USER=dbt_service_user
SNOWFLAKE_PASSWORD=your_secure_password_here

# Key-pair auth (for prod target — preferred over password)
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8

# GitHub (used by CI/CD pipeline)
GITHUB_REF_NAME=main
