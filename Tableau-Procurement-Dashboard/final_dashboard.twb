        <calculation class='tableau' formula='(SUM([Calculation_2274880821828038656]) - SUM([CY PO Amount (copy)_2274880821831593985])) / SUM([CY PO Amount (copy)_2274880821831593985])' />
      </column>
      <column caption='Min/Max PO Amount' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Calculation_2274880821836599301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_2274880821828038656]) = WINDOW_MAX(SUM([Calculation_2274880821828038656]))&#13;&#10;THEN SUM([Calculation_2274880821828038656])&#13;&#10;ELSEIF SUM([Calculation_2274880821828038656]) = WINDOW_MIN(SUM([Calculation_2274880821828038656]))&#13;&#10;THEN SUM([Calculation_2274880821828038656])&#13;&#10;END'>
