          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Year' datatype='integer' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2024'>
              <calculation class='tableau' formula='2024' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1s2kr8k0xfdn5e19desh519dt451'>
            <column caption='% Diff Potential Savings' datatype='real' default-format='p0.0%' name='[% Diff PO Amount (copy)_810929471823486984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_322570386478661637]) - SUM([CY Potential Savings (copy)_810929471824584717])) / SUM([CY Potential Savings (copy)_810929471824584717])' />
            </column>
            <column caption='Avg Buying Price' datatype='real' name='[Avg_Buying_Price]' role='measure' type='quantitative' />
            <column caption='Buyer Agent Name' datatype='string' name='[Buyer_Agent_Name]' role='dimension' type='nominal' />
            <column caption='PY Min Product Price' datatype='real' name='[CY Min Product Price (copy)_810929471824162825]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Product_Name] : MIN([PY PO Amount (copy)_2264466247726141459])}' />
            </column>
            <column caption='Current Year Order Quantity' datatype='integer' default-format='N' name='[CY PO Amount (copy)_2264466247715139587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([PO_Date]) = [Parameters].[Parameter 1] THEN [PO_Quantity]&#13;&#10;END' />
            </column>
            <column caption='CY Avg Buying Price' datatype='real' name='[CY PO Amount (copy)_2264466247726014482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([PO_Date]) = [Parameters].[Parameter 1] THEN [Avg_Buying_Price]&#13;&#10;END' />
            </column>
            <column caption='PY Potential Savings' datatype='real' default-format='C3081%' name='[CY Potential Savings (copy)_810929471824584717]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[CY Price Gap (copy)_810929471824371722] * [PY PO Amount (copy)_2264466247715254276]' />
            </column>
            <column caption='PY Price Gap' datatype='real' name='[CY Price Gap (copy)_810929471824371722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[PY PO Amount (copy)_2264466247726141459] - [CY Min Product Price (copy)_810929471824162825]' />
            </column>
            <column caption='{[% Diff Potential Savings]}' datatype='real' name='[Calculation_1475773367161376771]' role='measure' type='quantitative' user:unnamed='KPI PO Quantity (2)'>
              <calculation class='tableau' formula='{[% Diff PO Amount (copy)_810929471823486984]}' />
            </column>
            <column caption='{[% Diff Potential Savings]}' datatype='real' name='[Calculation_1475773367164268548]' role='measure' type='quantitative' user:unnamed='Total Potential Save by Buyer Agent'>
              <calculation class='tableau' formula='{[% Diff PO Amount (copy)_810929471823486984]}' />
            </column>
            <column caption='CY Min Product Price' datatype='real' name='[Calculation_322570386478346242]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Product_Name] : MIN([CY PO Amount (copy)_2264466247726014482])}' />
            </column>
            <column caption='CY Price Gap' datatype='real' name='[Calculation_322570386478493699]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[CY PO Amount (copy)_2264466247726014482] - [Calculation_322570386478346242]' />
            </column>
            <column caption='CY Potential Savings' datatype='real' default-format='C3081%' name='[Calculation_322570386478661637]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_322570386478493699] * [CY PO Amount (copy)_2264466247715139587]' />
