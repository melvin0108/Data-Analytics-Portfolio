              <calculation class='tableau' formula='IF [CY PO Amount (copy)_2264466247718031370] = WINDOW_MAX([CY PO Amount (copy)_2264466247718031370])&#13;&#10;THEN [CY PO Amount (copy)_2264466247718031370]&#13;&#10;ELSEIF [CY PO Amount (copy)_2264466247718031370] = WINDOW_MIN([CY PO Amount (copy)_2264466247718031370])&#13;&#10;THEN [CY PO Amount (copy)_2264466247718031370]&#13;&#10;END'>
