            </column>
            <column caption='PY Avg Buying Price' datatype='real' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[PY PO Amount (copy)_2264466247726141459]' role='measure' type='quantitative'>
