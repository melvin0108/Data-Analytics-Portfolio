          <datasource-dependencies datasource='federated.1s2kr8k0xfdn5e19desh519dt451'>
            <column caption='% Diff Avg Buying Price' datatype='real' default-format='p0.0%' name='[% Diff PO Amount (copy)_2264466247726481428]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([CY PO Amount (copy)_2264466247726014482]) - SUM([PY PO Amount (copy)_2264466247726141459])) / SUM([PY PO Amount (copy)_2264466247726141459])' />
