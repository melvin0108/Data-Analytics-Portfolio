            <column caption='Agent Specialization' datatype='string' name='[Calculation_810929471807082502]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Buyer_Agent_Name] = &quot;Amina El-Sayed&quot; THEN &quot;Wheel Components&quot;&#13;&#10;ELSEIF [Buyer_Agent_Name] = &quot;Mei Ling Chen&quot; THEN &quot;Core Systems&quot;&#13;&#10;ELSEIF [Buyer_Agent_Name] = &quot;Raj Malhotra-Bergman&quot; THEN &quot;E-Bike Systems&quot;&#13;&#10;ELSEIF [Buyer_Agent_Name] = &quot;Sofía Álvarez&quot; THEN &quot;Handlebar Accessories&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
