              <calculation class='tableau' formula='2024' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1s2kr8k0xfdn5e19desh519dt451'>
            <column caption='% Diff PO Quantity' datatype='real' default-format='p0.0%' name='[% Diff PO Amount (copy)_2264466247715414021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([CY PO Amount (copy)_2264466247715139587]) - SUM([PY PO Amount (copy)_2264466247715254276])) / SUM([PY PO Amount (copy)_2264466247715254276])' />
            </column>
            <column caption='Current Year Order Quantity' datatype='integer' default-format='N' name='[CY PO Amount (copy)_2264466247715139587]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([PO_Date]) = [Parameters].[Parameter 1] THEN [PO_Quantity]&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Current Year' datatype='integer' default-format='n0;-0' name='[Calculation_2264466247709638656]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column aggregation='Sum' caption='Previous Year' datatype='integer' default-format='n0;-0' name='[Calculation_2264466247709712385]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1] -1' />
            </column>
            <column caption='{SUM([CY PO Quantity])}' datatype='integer' datatype-customized='true' default-format='N' name='[Calculation_2264466247715946504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{SUM([CY PO Amount (copy)_2264466247715139587])}' />
            </column>
            <column caption='{[% Diff PO Quantity]}' datatype='real' name='[Calculation_2264466247715979273]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{[% Diff PO Amount (copy)_2264466247715414021]}' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Min/Max PO Quantity' datatype='integer' default-format='n&quot;$&quot;#,##0,K;-&quot;$&quot;#,##0,K' name='[Min/Max PO Amount (copy)_2264466247715618823]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([CY PO Amount (copy)_2264466247715139587]) = WINDOW_MAX(SUM([CY PO Amount (copy)_2264466247715139587]))&#13;&#10;THEN SUM([CY PO Amount (copy)_2264466247715139587])&#13;&#10;ELSEIF SUM([CY PO Amount (copy)_2264466247715139587]) = WINDOW_MIN(SUM([CY PO Amount (copy)_2264466247715139587]))&#13;&#10;THEN SUM([CY PO Amount (copy)_2264466247715139587])&#13;&#10;END'>
