          <formatted-text>
            <run fontname='Tableau Medium' fontsize='14'>Total Potential Save by Buyer Agent </run>
            <run fontname='Tableau Bold' fontsize='14'><![CDATA[<[federated.1s2kr8k0xfdn5e19desh519dt451].[sum:Calculation_1475773367161376771:qk]>]]></run>
            <run fontname='Tableau Semibold' fontsize='12'>Æ </run>
            <run fontcolor='#898989' fontname='Tableau Semibold' fontsize='12'>vs. PY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Procurement+ (Cleaned_Data_Velocipede_Cycles)' name='federated.1s2kr8k0xfdn5e19desh519dt451' />
