              <calculation class='tableau' formula='IF SUM([CY PO Amount (copy)_2264466247726014482]) = WINDOW_MAX(SUM([CY PO Amount (copy)_2264466247726014482]))&#13;&#10;THEN SUM([CY PO Amount (copy)_2264466247726014482])&#13;&#10;ELSEIF SUM([CY PO Amount (copy)_2264466247726014482]) = WINDOW_MIN(SUM([CY PO Amount (copy)_2264466247726014482]))&#13;&#10;THEN SUM([CY PO Amount (copy)_2264466247726014482])&#13;&#10;END'>
